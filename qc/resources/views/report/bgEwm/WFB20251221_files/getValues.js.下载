//回车监控
$(document).keydown(function(event){
	  if(event.keyCode ==13 && $_inputKey.length>0){
	  	console.log("$_enterKey")
          keyUpFunctionCallBack("enter");
	  }
	  else if(event.keyCode ==27 && $_inputKey.length>0){
	  	console.log("$_escKey")
		  //先取焦点
          keyUpFunctionCallBack("exit");
	  }else {
	  	if(typeof onKeyDownFunction4Self == "function"){
            onKeyDownFunction4Self(event);
		}
	  }

});

function keyUpFunctionCallBack(type) {
    //后取全局
    $.each($_inputKey,function(id,ent){
        if(typeof ent.tid == "string" ) {
            if ('all' == ent["trigger"] && type == ent.type ) {
                if (ent["fun"] == "this.click") {
                    console.log($("#" + ent['tid']),"this.click 222")
                    $("#" + ent['tid']).click();
                } else {
                    ent["fun"]();
                }
                if(ent.stopPropagation == true){
                    return false;
				}
                return;
            }
        }else {
            if ('all' == ent["trigger"] && type == ent.type ) {
                if (ent["fun"] == "this.click") {
                    console.log($(ent.tid),"this.click 333")
                    $(ent.tid).click();
                } else { 
                    ent["fun"]();
                }
                if(ent.stopPropagation == true){
                    return false;
                }
                return;
            }
        }
    });
}

/**
 * {"id":{trigger:"触发类型",fun:""}}
 */
var $_inputKey=[];


//按升序排列
function reverseMap4keys(){
    $_inputKey = $_inputKey.reverse() ;
}

/**
 * 回车触发（全局触发只能有一个）
 * @param trigger 触发类型  = focus|
 * focus:焦点触发 
 * @param fun 指定触发执行方法 
 * @param tid 触发执行id的click方法 fun无效
 */
jQuery.fn.enter = function(trigger,fun,tid,eleName,stopPropagation){
	var id=	$(this).attr("id"); 
	if(!fun){
		fun="this.click";
	}
	if(!id){
        id = eleName;
	}
	if(!tid){
        tid=this;
	}
	if(id){
		if(trigger){
            $_inputKey[$_inputKey.length]={"trigger":trigger,"tid":tid,"fun":fun,"type":"enter","stopPropagation":stopPropagation,"eleName":eleName};
		}else{
            $_inputKey[$_inputKey.length]={"trigger":"all","tid":tid,"fun":fun,"type":"enter","stopPropagation":stopPropagation,"eleName":eleName};
		}
	}else{
		console.log("无id，回车无法触发！");
	}
};
/**
 * ESC触发（全局触发只能有一个）
 */
jQuery.fn.exit = function(trigger,fun,tid,eleName,stopPropagation){
	var id=	$(this).attr("id");
	if(!fun){
		fun="this.click";
	}
	if(!id){
        id = eleName ;
	}
	if(!tid){
		tid=this;
	}
	if(id){
		if(trigger){
            $_inputKey[$_inputKey.length]={"trigger":trigger,"tid":tid,"fun":fun,"type":"exit","stopPropagation":stopPropagation,"eleName":eleName};
		}else{
            $_inputKey[$_inputKey.length]={"trigger":"all","tid":tid,"fun":fun,"type":"exit","stopPropagation":stopPropagation,"eleName":eleName};
		}
	}else{
		console.log("无id，回车无法触发！");
	}
};

/**
 * ESC触发（全局触发只能有一个）
 */
jQuery.fn.removeEnter = function(eleName){
    $_inputKey = $_inputKey.filter(item => {
        return eleName != item.eleName
    })
};

/**
 * ESC触发（全局触发只能有一个）
 */
jQuery.fn.removeExit = function(eleName){
    $_inputKey = $_inputKey.filter(item => {
        return eleName != item.eleName
    })
};

