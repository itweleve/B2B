/**
 * 抽取 id,name 同时不为空 表单对象值value
 * value="#aaa" 这种配置可以关联取值：当前对象取id为aaa的对象值
 * 获取指定对象内的对象值
 */
jQuery.fn.getValues = function(){
	var jsonparam={};
	//获取input控件值
	$(this).find("input").each(function(i, row){
		if('text'==row.type && typeof(row.name)!='undefined'){
			if($.trim(row.value).indexOf("#")==0){
				jsonparam[row.id]=$($.trim(row.value)).val();
			}else{
				jsonparam[row.id]=row.value;
			}
		}else if('hidden'==row.type && typeof(row.name)!='undefined'){
			if($.trim(row.value).indexOf("#")==0){
				jsonparam[row.id]=$($.trim(row.value)).val();
			}else{
				jsonparam[row.id]=row.value;
			}
		}else if('password'==row.type && typeof(row.name)!='undefined'){
			if($.trim(row.value).indexOf("#")==0){
				jsonparam[row.id]=$($.trim(row.value)).val();
			}else{
				jsonparam[row.id]=row.value;
			}
		}
	});
	//获取select控件值
	$(this).find("select").each(function(i, row){
		if( typeof(row.name)!='undefined'){
			if($.trim(row.value).indexOf("#")==0){
				jsonparam[row.id]=$($.trim(row.value)).val();
			}else{
				jsonparam[row.id]=row.value;
			}
		}
	});
	//获取textarea控件值
	$(this).find("textarea").each(function(i, row){
		if( typeof(row.name)!='undefined'){
			if($.trim(row.value).indexOf("#")==0){
				jsonparam[row.id]=$($.trim(row.value)).val();
			}else{
				jsonparam[row.id]=row.value;
			}
		}
	});
	//获取a控件值
	$(this).find("a").each(function(i, row){
		
		if( typeof(row.name)!='undefined'){
			if($.trim(row.value).indexOf("#")==0){
				jsonparam[row.id]=$($.trim(row.href)).val();
			}else{
				jsonparam[row.id]=row.href;
			}
		}
	});
	return jsonparam;
};



