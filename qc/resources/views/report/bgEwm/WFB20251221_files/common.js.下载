/**
 * 合并单元格
 * @param res
 * @param elm 需要合并的元素
 * @param columsName 需要合并的列名称
 * @param columsIndex 需要合并的列索引值
 * @param margeRow 是否是批量设置时左侧项目列表的合并
 * @param margeCheckBox 是否合并checkbox
 */
function merge(res,elm,columsName,columsIndex,margeRow,margeCheckBox) {
    console.log(res,elm,'res,elm');
    let tbody =  elm.find('.layui-table-box tbody') ;
    let data = res.data;
    for(let i=0;i<tbody.length;i++){
        //合并行
        if(margeRow == true){
            mergeRow(data,tbody.eq(i),columsName,columsIndex);
        }
        //合并列
        mergeCol(data,tbody.eq(i),columsName,columsIndex);
        //合并checkbox
        if(margeCheckBox == true){
            mergeCheckbox(data,tbody.eq(i),columsName,columsIndex);
        }
    }
}

