// 渲染autocomplete
function autoCompleteOnClick(type,obj,needAuto,dataKeyId,lay_index,lay_table_index,tableId,e){
    console.log("autoCompleteOnClick",type,obj,needAuto,dataKeyId,lay_index,lay_table_index,tableId);
    // 生成input
    if(e.button==2){ //鼠标右键
        if(e.target.tagName!='TEXTAREA'){
            obj.oncontextmenu = function(e){
                e.preventDefault();
            };
        }
        $(".layui-form-autocomplete-focus").remove()
        let i = $(obj);
        let n = $('<input clickDiveName="'+type+'AutoCompleteOnClickDiv" class="layui-input layui-table-edit " style="height: 100%!important">');
        // table
        if(i.find(".layui-table-edit").length >0){
            i.find(".layui-table-edit").eq(0).focus()
            var evtObj = document.createEvent('UIEvents');
            evtObj.initUIEvent('input', true, true, window, 1 );
            i.find(".layui-table-edit").eq(0)[0].dispatchEvent(evtObj)
            return ;
        }else {
            let value = i.children("."+type+"_val").html() ;
            if(value == defaultSpace){
                value = "" ;
            }
            n[0].value = value.replace(/<br>/g,'\n');
            i.append(n);
            n.focus();
            $(n).change(function () {
                let value = $(n).val().replace(/\n/g,'<br >');
                let showValue = (value == "" ? defaultSpace:value) ;
                let saveValue = value ;
                if(type == "test_way" ){
                    if (!!testWayValueData[dataKeyId]) {
                        let test_way = testWayValueData[dataKeyId] ;
                        test_way = test_way.split("%#~")[1] ;
                        saveValue = saveValue+"%#~"+test_way;
                    }
                }
                if(type == "zxr_name"){
                }else{
                    doAutoCompleteSetVal(type,showValue,saveValue,"."+type+"_val",lay_index,lay_table_index,tableId);
                }
                if(type == "tec_requirements" ){
                    // //项目检验，技术要求change事件  standard_value选择的标准值
                    if(typeof inputChange4Pd == 'function'){
                        inputChange4Pd(i,'jsyq',tableId);
                    }
                }else if(type == "dxjl" ){
                    if(typeof dxpdChange == 'function'){
                        dxpdChange(i,tableId);
                    }
                }else if(type == "zxr_name" ){
                    if(typeof zxrChange == 'function'){
                        zxrChange(i,tableId);
                    }
                }else if(type.indexOf("scz")!=-1){
                    // //项目检验，技术要求change事件  standard_value选择的标准值
                    if(typeof inputChange4Pd == 'function'){
                        inputChange4Pd(i,type,tableId);
                    }
                    if( typeof autoSaveItemInfo == 'function'){
                        autoSaveItemInfo();
                    }
                } else if (type == "zydw") {
                    if (typeof zydwChange == 'function') {
                        zydwChange(i, tableId);
                    }
                }
                // $(n).remove();
            })
        }
        if(needAuto == "1"){
            // 数据ID在的话，找数据
            let tempData = [] ;
            let template_val =  'val';
            let template_txt =  'html';
            if(!!dataKeyId) {
                if(type == "tec_requirements" ){
                    template_val =  'standard_value';
                    template_txt =  'html';
                    if (standardValueData.length > 0) {
                        for (var k = 0; k < standardValueData.length; k++) {
                            if (standardValueData[k].item_id == dataKeyId) {
                                tempData.push(standardValueData[k]);
                            }
                        }
                    }
                }else if(type == "test_way" ){
                    if (!!testWayValueData[dataKeyId]) {
                        let test_way = testWayValueData[dataKeyId] ;
                        test_way = test_way.split("%#~")[1].split("~#%") ;
                        for(let i=0;i<test_way.length;i++){
                            tempData[tempData.length] = {val:test_way[i],html:test_way[i]};
                        }
                    }
                }else if(type == "zxr_name" ){
                    $_PostSync("/qc/zjZuglService/findGroupUserIds/" + dataKeyId, {}, function (res) {
                        var data = res.data;
                        for(var ii =0 ; ii<data.length;ii++){
                            var tempObj = {val:data[ii].code,html:data[ii].remark};
                            tempData.push(tempObj);
                        }
                    });
                }
            }else {
                if(type == "dxjl" ){
                    tempData = [{val:userPdlx.satisfied_value,html:userPdlx.satisfied_value},{val:userPdlx.unsatisfied_value,html:userPdlx.unsatisfied_value}];
                } else if (type == "scz") {
                    tempData = [{val:'符合',html:'符合'},{val:'不符合',html:'不符合'}];
                }
