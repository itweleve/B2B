//合并行
function mergeRow(data,elm,columsName,columsIndex){
        //这里涉及到简单的运算，mark是计算每次需要合并的格子数
        let mark = 1;
        //所有行
        // var trArr = $(".layui-table-body>.layui-table").find("tr");
        let trArr = $(elm).find("tr");
        //先合并行
        for (let i = 0; i < data.length; i++) {
            //获取当前行
            let trCurArr = trArr.eq(i);
            $(trCurArr).parent().parent().css("width","100%");
            //循环列，要是后一列值为空，则与前一列合并
            for (let k = 0; k < columsName.length; k++){
                //后一行的值与前一行的值做比较，若后一行为空则合并
                if (data[i][columsName[k]]==null) {
                     mark += 1;
                     // 获得当前的宽度，设置到前一列，然后隐藏当前列
                    let trCurPrevAll = $(trCurArr.find("td").eq(columsIndex[k])).prevAll()
                    trCurPrevAll.each(function () {
                        if($(this).css("display") != "none"){
                            let tdWidth = $(this)[0].offsetWidth
                            let cellWidth = $(this).find('.layui-table-cell')[0].offsetWidth
                            $(this).width(tdWidth+$(trCurArr.find("td").eq(columsIndex[k])).width())
                            $(this).find('.layui-table-cell').width(cellWidth+$(trCurArr.find("td").eq(columsIndex[k])).find('.layui-table-cell').width())
                            $(this).attr("colspan", mark);
                            return false ;
                        }
                    }) ;

                    $(trCurArr.find("td").eq(columsIndex[k])).css("display", "none");
                }else{
                    //一旦前后两行的值没有空值，那么需要合并的格子数mark就需要重新计算
                    mark = 1;
                }
            }
            mark = 1;
        }
}

//合并列
function mergeCol(data,elm,columsName,columsIndex){
//定位需要添加合并属性的行数
    var mergeIndex = 0;
    //这里涉及到简单的运算，mark是计算每次需要合并的格子数
    var mark = 1;
    //循环所有要合并的列
    for (var k = 0; k < columsName.length; k++){
        //所有行
        // var trArr = $(".layui-table-body>.layui-table").find("tr");
        var trArr = $(elm).find("tr");
        //这里循环表格当前的数据
        dataFor:
        for (var i = 1; i < data.length; i++) {
            //获取当前行的当前列
            var tdCurArr = trArr.eq(i).find("td").eq(columsIndex[k]);
            //获取相同列的第一列
            var tdPreArr = trArr.eq(mergeIndex).find("td").eq(columsIndex[k]);
            //后一行的值与前一行的值做比较，相同就需要合并


            // if (data[i][columsName[k]] === data[i - 1][columsName[k]]&&data[i][columsName[k]]!=null) {
            if (($(tdPreArr).css('display')!='none' && $(tdCurArr).css('display')!='none') && data[i][columsName[k]] === data[i - 1][columsName[k]] && $(tdCurArr).attr('colspan')==$(tdPreArr).attr('colspan')) {
                // if(k>0 && data[i][columsName[k-1]] != data[i - 1][columsName[k-1]]){
                //前一列的值不一样 || 前一列没有隐藏 ，那么需要合并的格子数mark就需要重新计算
                if(k>0  && ((data[i][columsName[k-1]] != data[i - 1][columsName[k-1]]) || (trArr.eq(i).find("td").eq(columsIndex[k]-1).css('display')!='none') )){
                        mergeIndex = i;
                    mark = 1;
                    continue dataFor;
                }
                mark += 1;
                //相同列的第一列增加rowspan属性
                tdPreArr.each(function () {
                    $(this).attr("rowspan", mark);
                });
                //当前列隐藏
                tdCurArr.each(function () {
                    $(this).css("display", "none");
                });
            } else{
                mergeIndex = i;
                //一旦前后两行的值不一样了，那么需要合并的格子数mark就需要重新计算
                mark = 1;
            }

        }
        mergeIndex = 0;
        mark = 1;
    }
}

