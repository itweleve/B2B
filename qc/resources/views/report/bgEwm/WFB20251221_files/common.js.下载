            $(e).addClass("layui-form-checked");
        }
        $(e).siblings().prop('checked', !flag);
        table.cache[tableId][boxArr.indexOf(e)]["LAY_CHECKED"] = !flag;
    }else{
        if(!startChecked){
            startChecked = this;
        }
        if(e.shiftKey) {
            let start = boxArr.indexOf(startChecked);//开始选中的位置
            let end = boxArr.indexOf(this);//结束选中的位置
            boxArr.slice(Math.min(start, end), Math.max(start, end) + 1).forEach(
                function(item,i){
                    if($(startChecked).hasClass("layui-form-checked")){
                        $(item).addClass("layui-form-checked");
                        table.cache[tableId][Math.min(start, end)-1+i]["LAY_CHECKED"] = true;
                        $(item).siblings().prop('checked', true);
                    }else{
                        $(item).removeClass("layui-form-checked");
                        table.cache[tableId][Math.min(start, end)-1+i]["LAY_CHECKED"] = false;
                        $(item).siblings().prop('checked', false);
                    }
                }
            );
        }else{
            largeAndSmallSelect(this,largeRelSmall);
        }
        startChecked = this;
    }
}


/**
 * 设置大项、小项的关联关系
 */
function largeAndSmallSelect(obj,largeRelSmall) {
    let tableInfo = table.cache[tableId];
    let index = boxArr.indexOf(obj);//第一行的多选框去除
    if(index<=0){
        return;
    }
    let biaoshi = tableInfo[index-1].biao_shi;//项目标识0：子项 1：父项
    let id = !!tableInfo[index-1].item_id ? tableInfo[index-1].item_id :tableInfo[index-1].id;//项目标识id
    let fbiaoshi = tableInfo[index-1].fbiao_shi;//父项目标识id
    let name1 = tableInfo[index-1].name1;//项目名称1
    let flag = $(obj).hasClass("layui-form-checked");//是否勾选
    if(biaoshi=="1"){//大项
        for(let i=0;i< tableInfo.length;i++){
            if(tableInfo[i].fbiao_shi==id && tableInfo[i].name1 == name1){
                let DOM = boxArr[i+1];
                if(flag){
                    $(DOM).addClass("layui-form-checked");
                }else {
                    $(DOM).removeClass("layui-form-checked");
                }
                tableInfo[i]["LAY_CHECKED"] = flag;
                $(DOM).siblings().prop('checked', flag);
            }
        }
    }else { //小项
        if(!!fbiaoshi && largeRelSmall =="largeRelSmall"){
            for(let i=0;i< tableInfo.length;i++){
                let id = !!tableInfo[i].item_id ? tableInfo[i].item_id :tableInfo[i].id;//项目标识id
                if(id==fbiaoshi && tableInfo[i].name1 == name1){
                    let DOM = boxArr[i+1];
                    if(flag){
                        $(DOM).addClass("layui-form-checked");
                    }else {
                        $(DOM).removeClass("layui-form-checked");
                    }
                    tableInfo[i]["LAY_CHECKED"] = flag;
                    $(DOM).siblings().prop('checked', flag);
                    break;
                }
            }
        }
    }
}

