                        for (var i = 0; i < data.length; i++) {
                            if (sczArr == data[i].remark) {
                                if (data[i].code.indexOf("不") != -1) {//包含'不'字则不合格
                                    isQualified = false;
                                    break;
                                }
                            }
                        }
                        //当次判定 2不变1合格0不合格
                        if (isQualified) {
