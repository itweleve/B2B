                    }
                    //存入拼接后的item_id
                    itemIdTd.text(itemIds.substr(0,itemIds.length-1));
                }
            }
        }
}

/**
 * name1~name3去重获取数据
 */
function uniqueArray(data) {
    var temp = {};   //用于name1~name3判断重复
    var uniqueArray = [];  //去重后的数组
    var sameNameItemId= [];//相同项目名称,项目ids,以及需存放的位置
    //遍历数组，将每个item.name~name3在temp中是否存在值做判断
    data.map(function (item, index) {
        if(!temp[item.name1+"@#"+item.name2+"@#"+item.name3]){
            uniqueArray.push(item);
            temp[item.name1+"@#"+item.name2+"@#"+item.name3] = true;
            sameNameItemId.push({names:item.name1+"@#"+item.name2+"@#"+item.name3,item_id:item.item_id,postion:uniqueArray.length-1});
        }else{
            for( var i=0;i < sameNameItemId.length;i++){
                if(sameNameItemId[i].names == item.name1+"@#"+item.name2+"@#"+item.name3){
                    sameNameItemId[i].item_id = sameNameItemId[i].item_id +"," + item.item_id;
                }
            }
        }
    });
    for(var j=0;j<sameNameItemId.length;j++){
        uniqueArray[sameNameItemId[j].postion].item_id =sameNameItemId[j].item_id;
    }
    return uniqueArray;
}

