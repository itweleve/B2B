/**
 * 时间格式化
 * @param val 日期
 * @param pattern 转化日期的类型
 * @returns {null}
 */
function formatDate(val,pattern){
    if (val != null && val != "") {
        var date = new Date(val);
        return date.format(pattern);
    } else {
        return null;
    }
}

/**
 * 获取指定n天前的时间
 * @param val 往前查询天数
 * @param pattern 转化日期的类型
 * @returns {null}
 */
function formatDate4NDays(days,pattern){
    if (isNaN(days)) {
        return null;
    } else {
        var date = new Date(new Date().getTime()-(days * 3600 * 24 * 1000));
        return date.format(pattern);
    }
}

