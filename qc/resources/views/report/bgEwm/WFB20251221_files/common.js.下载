/**
 * 实测值判定
 * @param mynum
 * @param jsyqValTemp
 * @param fuhao
 * @param fuhao2
 * @returns {number}
 */
function judgeSczQualified(mynum,jsyqValTemp,fuhao,fuhao2) {
    let pdResTemp = 2;
    if(fuhao=='≥'|| fuhao2=='>=' || fuhao=='≧' ||  fuhao2=='＞＝' ){
        let yaoqiuzhi = jsyqValTemp.substr(1,jsyqValTemp.length);
        if(fuhao2=='>=' || fuhao2=='＞＝'){
            yaoqiuzhi = jsyqValTemp.substr(2,jsyqValTemp.length);
        }
        if(yaoqiuzhi=='' || isNaN(yaoqiuzhi)){
            return pdResTemp;
        }
        if(Number(mynum)>=Number(yaoqiuzhi)) {
            pdResTemp = 1;
        }else{
            pdResTemp = 0;
        }
    }else if(fuhao=='＞' || fuhao=='>' ){
        let yaoqiuzhi = jsyqValTemp.substr(1,jsyqValTemp.length);
        if(yaoqiuzhi=='' || isNaN(yaoqiuzhi)){
            return pdResTemp;
        }

        if(Number(mynum)> Number(yaoqiuzhi)) {
            pdResTemp = 1;
        }else{
            pdResTemp = 0;
        }
    }else if(fuhao=='≤'|| fuhao2=='<=' || fuhao=='≦' ||  fuhao2=='＜＝' ){
        let yaoqiuzhi = jsyqValTemp.substr(1,jsyqValTemp.length);
        if(fuhao2=='<=' || fuhao2=='＜＝'){
            yaoqiuzhi = jsyqValTemp.substr(2,jsyqValTemp.length);
        }
        if(yaoqiuzhi=='' || isNaN(yaoqiuzhi)){
            return pdResTemp;
        }
        if(Number(mynum)<=Number(yaoqiuzhi)) {
            pdResTemp = 1;
        }else{
            pdResTemp = 0;
        }
    } else if(fuhao=='＜' || fuhao=='<'){
        let yaoqiuzhi = jsyqValTemp.substr(1,jsyqValTemp.length);
        if(yaoqiuzhi=='' || isNaN(yaoqiuzhi)){
            return pdResTemp;
        }
        if(Number(mynum) < Number(yaoqiuzhi)) {
            pdResTemp = 1;
        }else{
            pdResTemp = 0;
        }
    }else if(fuhao=='±'){
        let yaoqiuzhi = jsyqValTemp.substr(1,jsyqValTemp.length);
        if(yaoqiuzhi=='' || isNaN(yaoqiuzhi)){
