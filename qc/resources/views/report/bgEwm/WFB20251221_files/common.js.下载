/**
 * 针对实测值、技术要求带横杠的修改 例如：3-4（相当于3.5）
 * @param mynum 实测值
 * @param jsyqValTemp 技术要求
 */
function specialjudgeSczQualified(mynum,jsyqValTemp) {
    var pdResTemp = 2;
    let mynumArr   = mynum.split("-");//实测值内容
    let jsyqValArr;
    let fuhao = jsyqValTemp.substr(0,1);//取第一个符号
    let fuhaoObj = {
        "≥":">=",">=":">=", "≧":">=","＞＝":">=",
        "＞":">",">":">",
        "≤":"<=","<=":"<=", "≦":"<=","＜＝":"<=",
        "＜":"<","<":"<",
    };
    let yaoqiuzhi = jsyqValTemp.substr(1,jsyqValTemp.length);
    if(isNaN(jsyqValTemp.substr(1,1))){
        fuhao = jsyqValTemp.substr(0,2);//取第二个符号
        yaoqiuzhi = jsyqValTemp.substr(2,jsyqValTemp.length);
    }
    jsyqValArr = yaoqiuzhi.split("-");//技术要求内容
    if(yaoqiuzhi =='' || isNaN(jsyqValArr[0]) || isNaN(mynumArr[0]) || !fuhaoObj[fuhao]){
        return pdResTemp;
    }
    if(jsyqValArr.length==1){//技术要求不带"-"号,则实测值肯定带"-"号
        let str = mynumArr[0]+fuhaoObj[fuhao]+jsyqValArr[0];
        if(fuhaoObj[fuhao]==">" || fuhaoObj[fuhao]=="<="){
            str = mynumArr[1]+fuhaoObj[fuhao]+jsyqValArr[0];
        }
        if(eval(str)) {
            pdResTemp = 1;
        }else{
            pdResTemp = 0;
        }
    }else {//技术要求带"-"号,则实测值带"-"号不确定
        if(isNaN(jsyqValArr[1])){
            return pdResTemp;
        }
        if(mynumArr.length==1){//实测值不带"-"号
            let str = mynumArr[0]+fuhaoObj[fuhao]+jsyqValArr[0];
            if(fuhaoObj[fuhao]=="<" || fuhaoObj[fuhao]==">="){
                str = mynumArr[0]+fuhaoObj[fuhao]+jsyqValArr[1];
            }
            if(eval(str)) {
                pdResTemp = 1;
            }else{
                pdResTemp = 0;
            }
        }else {//实测值带"-"号
            if(eval(mynumArr[0]+fuhaoObj[fuhao]+jsyqValArr[0]) && eval(mynumArr[1]+fuhaoObj[fuhao]+jsyqValArr[1])) {
                pdResTemp = 1;
            }else{
                pdResTemp = 0;
            }
        }
    }
    return pdResTemp;
}


