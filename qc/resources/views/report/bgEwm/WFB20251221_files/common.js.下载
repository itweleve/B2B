/**
 * 通过 location.search 获取get参数
 */
function getUrlParams() {
    //返回一个json格式的对象
    let urlParamObj = {};
    let ulParams = location.search.substr(1) ;
    //将各个参数截取出来
    let urlParamArr = ulParams.split("&") ;
    for(let i=0;i<urlParamArr.length;i++){
        let tempParam = urlParamArr[i].split("=") ;
        urlParamObj[tempParam[0]] = tempParam[1] ;
    }
    return urlParamObj ;
}

