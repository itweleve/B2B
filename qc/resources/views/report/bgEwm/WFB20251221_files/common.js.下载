/**
 * 初始化查询获取配置文件
 * @param config 数组方式传递(需要查询的配置文件),
 */
function queryConfig(config) {
    //存放本地存储没有的配置文件名称
    var configNameTemp = [];
    //查询本地存储没有的配置文件
    for(var i=0;i<config.length;i++){
        if(window.localStorage[config[i]] == null){
            configNameTemp[i]=config[i];
        }
    }
    if(configNameTemp.length>0) {
        //加载本地存储没有的配置文件
        $_PostSync("/qc/findParams/" + configNameTemp.join('$'),{},function (res) {
            for(var i=0;i<configNameTemp.length;i++){
                //存放查询出来的配置文件（包含默认值,集合值）
                // var json={};
                //取字典服务的默认值
                // json.value=res[configNameTemp[i]]["value"];
                //取字典服务的配置集合值
                // json.list= JSON.stringify(res[configNameTemp[i]]["list"]);
                if(res[configNameTemp[i]] != null){
                    window.localStorage[configNameTemp[i]]=JSON.stringify(res[configNameTemp[i]]);
                }
            }
        });
    }
}


/**
 * 获取配置文件
 * @param configName 数据字典名称
 */
function getConfig(configName) {
    if(window.localStorage[configName] == null ){
        $_PostSync("/qc/findParam/"+configName, {}, function (res) {
            window.localStorage[configName]=JSON.stringify(res);
        });
    }

    return window.localStorage[configName] != null ? $.parseJSON( window.localStorage[configName] ) : {}
}



