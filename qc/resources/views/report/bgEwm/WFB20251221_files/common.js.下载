/**
 *计算页面的实际高度
 */
function calcPageHeight() {
    var cHeight = Math.max(document.body.clientHeight, document.documentElement.clientHeight);
    var sHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
    return Math.max(cHeight, sHeight);
}
/**
 *计算页面的实际高度
 */
function calcTopPageHeight() {
    var cHeight = Math.max(top.document.body.clientHeight, top.document.documentElement.clientHeight);
    var sHeight = Math.max(top.document.body.scrollHeight, top.document.documentElement.scrollHeight);
    return Math.max(cHeight, sHeight);
}

