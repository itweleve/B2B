    let tr02 = tbody.eq(2).find('tr') ;
    tableDate.map(function (item, index) {
        // 当前选中行
        if (newSjdId == item.id) {
            tr.eq(index).addClass("onSjdChoosedCss");
            tr01.eq(index).addClass("onSjdChoosedCss");
            tr02.eq(index).addClass("onSjdChoosedCss");
            // 加急,并且为江阴质检请求时,附加加急样式
            // if (item.sfjj == 1 && "2" == localStorage.getItem("depBusinessType")) {
            if (item.sfjj == 1) {
                tr.eq(index).removeClass("onSjdSfjjChoosedCss");
                tr01.eq(index).removeClass("onSjdSfjjChoosedCss");
                tr02.eq(index).removeClass("onSjdSfjjChoosedCss");
            }
        } else {
            // 加急,并且为江阴质检请求时,去除加急样式
            // if (item.sfjj == 1 && "2" == localStorage.getItem("depBusinessType")) {
            // 加急
            if (item.sfjj == 1) {
                tr.eq(index).addClass("onSjdSfjjChoosedCss");
                tr01.eq(index).addClass("onSjdSfjjChoosedCss");
                tr02.eq(index).addClass("onSjdSfjjChoosedCss");
            }
        }
        // 上一行跟当前点击的不是同一行时,去除选中的样式
        if (oldSjdId == item.id && newSjdId != oldSjdId) {
            tr.eq(index).removeClass("onSjdChoosedCss");
            tr01.eq(index).removeClass("onSjdChoosedCss");
            tr02.eq(index).removeClass("onSjdChoosedCss");
        }
