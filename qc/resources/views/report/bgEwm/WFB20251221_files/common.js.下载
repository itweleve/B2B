    $(".dd").css({"display":'none'})
}

function mousedowns(x,nowLayerId){
    let ww=$("#layui-layer"+nowLayerId).width()
    $("#layui-layer"+nowLayerId).on("selectstart",function () {
        return false
    })
    let anx=0
    document.onmousemove = function(ev) {
        isZytlgc=1
        anx=1
        var o = event || ev;
    }
    //当鼠标按键抬起，清除移动事件
    document.onmouseup = function(ev) {
        var o = event || ev;
        if(o.clientX>0&&anx==1){
