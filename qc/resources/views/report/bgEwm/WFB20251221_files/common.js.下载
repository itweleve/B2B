// 左右拖拉
function changed(nowLayerId){
    widths=$("#layui-layer"+nowLayerId)[0].offsetLeft
    $("#layui-layer"+nowLayerId).append('<div style="position:absolute;top: 0;left:-3px;width: 100%;height: 100%;z-index:100000;" class="dd" onclick="ddClick()"></div>')
    document.onmouseover=function(evt){
        var e = event || window.event;
        var scrollX = document.documentElement.scrollLeft || document.body.scrollLeft;
        var scrollY = document.documentElement.scrollTop || document.body.scrollTop;
        var x = e.pageX || e.clientX + scrollX;
        var y = e.pageY || e.clientY + scrollY;
        if(x-widths<5&&x-widths>-5){
            $(".dd").css({"display":'block'})
            $("#layui-layer"+nowLayerId).append('<div style="position:absolute;top: 0;left:-6px;width: 6px;height: 100%;z-index:1000000;cursor:col-resize" class="borderDiv" onmousedown="mousedowns('+x+','+nowLayerId+')"></div>')
        }
        if(x-widths>6||x-widths<-6){
            $(".dd").css({"display":'none'})
            $(".borderDiv").remove()
        }
    }
}
