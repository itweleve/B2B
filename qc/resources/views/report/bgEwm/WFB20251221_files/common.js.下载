                        if (typeof zxrChange == 'function') {
                            zxrChange(i, tableId);
                        }
                    } else if (type == "zydw") {
                        if (typeof zydwChange == 'function') {
                            zydwChange(i, tableId);
                        }
                    }else if(type == "scz"){
                        // //项目检验，技术要求change事件  standard_value选择的标准值
                        if(typeof inputChange4Pd == 'function'){
                            inputChange4Pd(i,type,tableId);
                        }
                        if( typeof autoSaveItemInfo == 'function'){
                            autoSaveItemInfo();
                        }
                    }
                    i.find(".layui-table-edit").eq(0).hide();
                },
            });

            setTimeout(()=>{
                i.find(".layui-table-edit").eq(0).focus();
            })
            return ;
        }
