//对授权机构ID的交集数据的处理
function innerJoinData(arrs) {
    let tempArray = []
    for (let i = 0; i < arrs.length; i++) {
        if(i==0){
            tempArray = arrs[i]
        }else {
            tempArray = tempArray.filter(function(v){return arrs[i].indexOf(v) > -1 })
        }
    }
    var tempArraystr = [];
    for (let i = 0; i < tempArray.length; i++) {
        if(tempArray[i]!=undefined && tempArray[i]!="" ){
            tempArraystr.push(tempArray[i]);
        }
    }
    return tempArraystr;
}

