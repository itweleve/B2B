/**
 * 数组内元素去重
 * @param array
 * @returns {Array}
 */
function unique(array){
    var temp = [];
    var l = array.length;
    for(var i = 0; i < l; i++) {
        for(var j = i + 1; j < l; j++){
            if (array[i] === array[j]){
                j = ++i;
            }
        }
        temp.push(array[i]);
    }
    return temp;
}

